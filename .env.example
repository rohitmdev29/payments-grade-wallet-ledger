# Database connection string for async SQLAlchemy engine.
# NOTE: Local host port is 5436 (mapped to container's 5432) to avoid
# clashing with other projects on this machine.
DATABASE_URL=postgresql+asyncpg://wallet:wallet@localhost:5436/wallet

# LLM provider configuration.
# Use "mock" for tests (no API key required) or "openai" for production.
LLM_PROVIDER=mock
OPENAI_API_KEY=sk-placeholder